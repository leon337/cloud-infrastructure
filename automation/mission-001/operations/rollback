#!/usr/bin/env bash
set -Eeuo pipefail

readonly EXPECTED_MISSION=CODEX-EXECUTION-MISSION-001
readonly EXPECTED_HOST=vmi3506102
readonly EXPECTED_MACHINE_ID_SHA256=27cff9587c434cf9024bd88468a8997778a64ce9ca5c3dc8dbcb68e0aee8f107
readonly BASE_HELPER=/usr/local/libexec/cloud-platform-network-enforcement
readonly BASE_UNIT=/etc/systemd/system/cloud-platform-network-enforcement.service
readonly BASE_DROPIN=/etc/systemd/system/docker.service.d/20-cloud-platform-network-enforcement.conf
readonly BASE_MARKER=/etc/cloud-platform-network-enforcement.managed
readonly SERVICE_HELPER=/usr/local/libexec/cloud-platform-network-services
readonly SERVICE_UNIT=/etc/systemd/system/cloud-platform-network-services.service
readonly SERVICE_ROOT=/etc/cloud-platform/network-services
readonly SERVICE_MARKER=/etc/cloud-platform-network-services.managed
readonly SYSCTL_FILE=/etc/sysctl.d/90-cloud-platform-network-forwarding.conf

refuse() { printf 'MISSION_ROLLBACK_REFUSED reason=%s\n' "$1" >&2; exit 2; }

[[ $EUID -eq 0 ]] || refuse root_required
[[ $# -eq 0 ]] || refuse arguments_forbidden
[[ ${MISSION_ID:-} == "$EXPECTED_MISSION" ]] || refuse wrong_mission
[[ ${MISSION_REPOSITORY:-} == /opt/codex-mission-001/repository ]] || refuse wrong_repository
[[ $(hostname) == "$EXPECTED_HOST" ]] || refuse wrong_host
machine_id_sha256=$(tr -d '\n' </etc/machine-id | sha256sum | awk '{print $1}')
[[ $machine_id_sha256 == "$EXPECTED_MACHINE_ID_SHA256" ]] || refuse wrong_machine_id

if [[ -e $SERVICE_MARKER || -L $SERVICE_MARKER ]]; then
  [[ -f $SERVICE_MARKER && ! -L $SERVICE_MARKER ]] || refuse service_marker_drift
  [[ -x $SERVICE_HELPER && -f $SERVICE_UNIT && -f $SYSCTL_FILE ]] ||
    refuse service_surface_incomplete
  "$SERVICE_HELPER" check >/dev/null || refuse service_drift
  systemctl disable --now cloud-platform-network-services.service
  "$SERVICE_HELPER" rollback
  for scope in cp00000002 cp00000003; do
    for file in Corefile records.hosts squid.conf; do
      [[ -f $SERVICE_ROOT/$scope/$file && ! -L $SERVICE_ROOT/$scope/$file ]] ||
        refuse "service_config_missing_$scope/$file"
      unlink -- "$SERVICE_ROOT/$scope/$file"
    done
    rmdir "$SERVICE_ROOT/$scope"
  done
  [[ -f $SERVICE_ROOT/compose.yaml && ! -L $SERVICE_ROOT/compose.yaml ]] ||
    refuse compose_missing
  unlink -- "$SERVICE_ROOT/compose.yaml"
  rmdir "$SERVICE_ROOT"
  rmdir /etc/cloud-platform 2>/dev/null || true
  unlink -- "$SYSCTL_FILE"
  unlink -- "$SERVICE_UNIT"
  unlink -- "$SERVICE_HELPER"
  systemctl daemon-reload
  unlink -- "$SERVICE_MARKER"
  for service in ssh ufw fail2ban xrdp xrdp-sesman docker containerd \
    cloud-platform-network-enforcement; do
    systemctl is-active --quiet "$service" || refuse "post_rollback_inactive_service_$service"
  done
  printf '%s\n' 'MISSION_ROLLBACK=PASS slice=F1.2c_network_services base_preserved=true'
  exit 0
fi

[[ -x $BASE_HELPER && -f $BASE_UNIT && -f $BASE_DROPIN && -f $BASE_MARKER ]] ||
  refuse managed_base_surface_incomplete
if ip -o link show | awk -F': ' '{print $2}' | grep -Eq '^cp[0-9a-f]{8}(@|$)'; then
  refuse managed_interface_present
fi
[[ -z $(docker container ls --all --quiet) ]] || refuse containers_present
[[ -z $(docker image ls --all --quiet) ]] || refuse images_present
[[ -z $(docker network ls --filter type=custom --quiet) ]] || refuse custom_networks_present
"$BASE_HELPER" check >/dev/null || refuse enforcement_drift
systemctl disable --now cloud-platform-network-enforcement.service
"$BASE_HELPER" rollback
unlink -- "$BASE_DROPIN"
unlink -- "$BASE_UNIT"
unlink -- "$BASE_HELPER"
systemctl daemon-reload
for service in ssh ufw fail2ban xrdp xrdp-sesman docker containerd; do
  systemctl is-active --quiet "$service" || refuse "post_rollback_inactive_service_$service"
done
printf '%s\n' 'MISSION_ROLLBACK=PASS slice=F1.2c_base'
