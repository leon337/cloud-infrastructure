#!/usr/bin/env bash
set -Eeuo pipefail

readonly EXPECTED_MISSION=CODEX-EXECUTION-MISSION-001
readonly EXPECTED_HOST=vmi3506102
readonly EXPECTED_MACHINE_ID_SHA256=27cff9587c434cf9024bd88468a8997778a64ce9ca5c3dc8dbcb68e0aee8f107
readonly EXPECTED_RUNNER_SHA256=4da7430f033aa8f0580205ee117a3d9d32b44f1d38bc2b386589f3ecce710d06
readonly SOURCE_SCRIPT_SHA256=11468ad2031e65d9824c77ed15222ed520251aff07d32d6b85a6484af21d24b4
readonly SOURCE_UNIT_SHA256=32a200e1512c64af055278ba37d760c73979cf1fd4fff438d10148f33e67fb62
readonly SOURCE_DROPIN_SHA256=a83bff96d635e0d13227d50e2f34512824e0389d6dd925ba681d334256bb0cc0
readonly HELPER=/usr/local/libexec/cloud-platform-network-enforcement
readonly UNIT=/etc/systemd/system/cloud-platform-network-enforcement.service
readonly DROPIN=/etc/systemd/system/docker.service.d/20-cloud-platform-network-enforcement.conf
readonly MARKER=/etc/cloud-platform-network-enforcement.managed
readonly LOCK=/run/lock/codex-mission-001-network-apply.lock

refuse() {
  printf 'MISSION_APPLY_REFUSED reason=%s\n' "$1" >&2
  exit 2
}

file_matches() {
  local path=$1 mode=$2 digest=$3
  [[ -f $path && ! -L $path ]] || return 1
  [[ $(stat -c '%U:%G:%a:%h' "$path") == "root:root:$mode:1" ]] || return 1
  [[ $(sha256sum "$path" | awk '{print $1}') == "$digest" ]]
}

require_empty_runtime() {
  [[ -z $(docker container ls --all --quiet) ]] || refuse containers_present
  [[ -z $(docker image ls --all --quiet) ]] || refuse images_present
  [[ -z $(docker volume ls --quiet) ]] || refuse volumes_present
  [[ -z $(docker network ls --filter type=custom --quiet) ]] || refuse custom_networks_present
  [[ -z $(docker buildx du --format '{{.ID}}') ]] || refuse build_cache_present
  if ip -o link show | awk -F': ' '{print $2}' | grep -Eq '^cp[0-9a-f]{8}(@|$)'; then
    refuse managed_interface_present
  fi
}

[[ $EUID -eq 0 ]] || refuse root_required
[[ $# -eq 0 ]] || refuse arguments_forbidden
[[ ${MISSION_ID:-} == "$EXPECTED_MISSION" ]] || refuse wrong_mission
[[ ${MISSION_REPOSITORY:-} == /opt/codex-mission-001/repository ]] || refuse wrong_repository
[[ $(hostname) == "$EXPECTED_HOST" ]] || refuse wrong_host
machine_id_sha256=$(tr -d '\n' </etc/machine-id | sha256sum | awk '{print $1}')
[[ $machine_id_sha256 == "$EXPECTED_MACHINE_ID_SHA256" ]] || refuse wrong_machine_id
runner_sha256=$(sha256sum /usr/local/sbin/codex-mission-001-runner | awk '{print $1}')
[[ $runner_sha256 == "$EXPECTED_RUNNER_SHA256" ]] || refuse runner_version_drift
exec 9>"$LOCK"
flock -n 9 || refuse concurrent_operation

for service in ssh ufw fail2ban xrdp xrdp-sesman docker containerd; do
  systemctl is-active --quiet "$service" || refuse "inactive_required_service_$service"
done
systemctl is-active --quiet snap.lxd.daemon.service && refuse lxd_daemon_active
systemctl is-active --quiet snap.lxd.daemon.unix.socket && refuse lxd_socket_active
[[ -f /etc/cloud-platform-foundation.managed && ! -L /etc/cloud-platform-foundation.managed ]] ||
  refuse foundation_marker_missing
[[ -f /etc/cloud-platform-docker-runtime.managed && ! -L /etc/cloud-platform-docker-runtime.managed ]] ||
  refuse docker_marker_missing
grep -qx 'slice=SLICE-001' /etc/cloud-platform-foundation.managed || refuse foundation_marker_drift
grep -qx 'slice=SLICE-002B' /etc/cloud-platform-docker-runtime.managed || refuse docker_marker_drift
require_empty_runtime

source_script="$MISSION_REPOSITORY/platform/network/cloud-platform-network-enforcement"
source_unit="$MISSION_REPOSITORY/platform/systemd/cloud-platform-network-enforcement.service"
source_dropin="$MISSION_REPOSITORY/platform/systemd/docker.service.network-enforcement.conf"
[[ $(sha256sum "$source_script" | awk '{print $1}') == "$SOURCE_SCRIPT_SHA256" ]] || refuse source_script_drift
[[ $(sha256sum "$source_unit" | awk '{print $1}') == "$SOURCE_UNIT_SHA256" ]] || refuse source_unit_drift
[[ $(sha256sum "$source_dropin" | awk '{print $1}') == "$SOURCE_DROPIN_SHA256" ]] || refuse source_dropin_drift

if [[ -e $MARKER || -L $MARKER ]]; then
  file_matches "$HELPER" 755 "$SOURCE_SCRIPT_SHA256" || refuse installed_helper_drift
  file_matches "$UNIT" 644 "$SOURCE_UNIT_SHA256" || refuse installed_unit_drift
  file_matches "$DROPIN" 644 "$SOURCE_DROPIN_SHA256" || refuse installed_dropin_drift
  systemctl is-enabled --quiet cloud-platform-network-enforcement.service || refuse enforcement_service_not_enabled
  systemctl is-active --quiet cloud-platform-network-enforcement.service || refuse enforcement_service_not_active
  "$HELPER" check >/dev/null || refuse enforcement_check_failed
  printf '%s\n' 'MISSION_APPLY=PASS slice=F1.2c_base changed=0'
  exit 0
fi

for path in "$HELPER" "$UNIT" "$DROPIN"; do
  [[ ! -e $path && ! -L $path ]] || refuse "unmanaged_collision_$path"
done
[[ -x /usr/local/sbin/cloud-infrastructure-config-backup ]] || refuse backup_command_missing
/usr/local/sbin/cloud-infrastructure-config-backup >/dev/null || refuse preapply_backup_failed
install -d -o root -g root -m 0755 /usr/local/libexec
install -o root -g root -m 0755 "$source_script" "$HELPER"
install -o root -g root -m 0644 "$source_unit" "$UNIT"
install -o root -g root -m 0644 "$source_dropin" "$DROPIN"
"$HELPER" apply
systemctl daemon-reload
systemctl enable --now cloud-platform-network-enforcement.service
file_matches "$HELPER" 755 "$SOURCE_SCRIPT_SHA256" || refuse post_install_helper_drift
file_matches "$UNIT" 644 "$SOURCE_UNIT_SHA256" || refuse post_install_unit_drift
file_matches "$DROPIN" 644 "$SOURCE_DROPIN_SHA256" || refuse post_install_dropin_drift
systemctl is-enabled --quiet cloud-platform-network-enforcement.service || refuse post_install_service_not_enabled
systemctl is-active --quiet cloud-platform-network-enforcement.service || refuse post_install_service_not_active
"$HELPER" check >/dev/null || refuse post_install_enforcement_check_failed
require_empty_runtime
for service in ssh ufw fail2ban xrdp xrdp-sesman docker containerd; do
  systemctl is-active --quiet "$service" || refuse "post_install_inactive_service_$service"
done
printf '%s\n' 'MISSION_APPLY=PASS slice=F1.2c_base changed=1'
